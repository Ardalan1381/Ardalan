# CafeMenu environment template.
# Copy to .env, then run:  php artisan key:generate && php artisan app:ensure-reverb-credentials
# Never commit the real .env. Keep a separate secure copy of APP_KEY: without
# it, encrypted columns (payment gateway credentials) cannot be read after a
# restore.

APP_NAME=CafeMenu
# The web installer switches these to production/false when it finishes.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must be the real public URL. With https:// session cookies become Secure
# automatically (see SESSION_SECURE_COOKIE below).
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# MySQL 8+ or MariaDB 10.6+ (the installer fills these in).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafemenu
DB_USERNAME=cafemenu
DB_PASSWORD=

# file works before the installer has configured a database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset to follow APP_URL (https => true). Set false only for a
# plain-HTTP LAN install.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (real-time). Generated by `php artisan app:ensure-reverb-credentials`.
# Build frontend assets (npm run build) only AFTER these have real values:
# VITE_REVERB_* are baked into the compiled JavaScript at build time.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/port/scheme browsers connect to (your reverse proxy).
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https
# Where the Reverb process itself listens (behind the proxy).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Iranian payment gateways (optional). Values entered in the admin panel's
# business settings override these. Leave blank when not used.
PAYMENT_GATEWAY_AMOUNT_UNIT=toman
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT=
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
