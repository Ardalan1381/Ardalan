<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Multi-process race tests. They skip themselves on SQLite and
            only run when DB_CONNECTION points at MySQL/MariaDB — see
            docs/engineering/TESTING.md.
        -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Assertions are written against English copy; never inherit the
             install's locale from .env (.env.example defaults to fa). -->
        <env name="APP_LOCALE" value="en"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
            Payment gateway credentials must never leak in from a developer's
            local .env — tests that need a "configured" gateway set it
            explicitly via config(), so the baseline here always matches the
            "nothing configured yet" state .env.example ships with.
        -->
        <env name="ZARINPAL_MERCHANT_ID" value=""/>
        <env name="ZARINPAL_SANDBOX" value="false"/>
        <env name="ZIBAL_MERCHANT" value=""/>
        <env name="MELLAT_TERMINAL_ID" value=""/>
        <env name="MELLAT_USERNAME" value=""/>
        <env name="MELLAT_PASSWORD" value=""/>
    </php>
</phpunit>
