# Used only when the web server's document root is the project root
# instead of public/ (shared hosting). Prefer pointing the document root at
# public/ — see docs/deployment/INSTALLATION.md.

Options -Indexes

# Never serve dotfiles (.env, .git, .htaccess) or files that may contain
# secrets/data, even if a request bypasses the rewrite below.
<FilesMatch "(^\.|\.(env|log|sql|sqlite|lock|bak|sh)$|^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application internals are never reachable directly.
    RewriteRule ^(app|bootstrap|config|database|deploy|docs|lang|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]

    # Everything else is served from public/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
